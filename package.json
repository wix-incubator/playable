{
  "name": "playable",
  "version": "2.15.4",
  "description": "Video player based on HTML5Video",
  "keywords": [
    "adaptive",
    "dash",
    "hls",
    "html5",
    "media",
    "mpeg",
    "mse",
    "player",
    "video"
  ],
  "homepage": "https://wix.github.io/playable/",
  "bugs": {
    "url": "https://github.com/wix/playable/issues",
    "email": "oleksiim@wix.com"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:wix/playable.git"
  },
  "license": "MIT",
  "author": {
    "name": "Oleksii Makodzeba",
    "email": "oleksiim@wix.com"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "dist/statics/playable.bundle.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "start": "npm run bundle && npx serve dist/statics -p 5000",
    "lint": "npm run tslint:all",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:types": "tsc -p tsconfig.build.json",
    "bundle": "rollup -c rollup.config.mjs",
    "bundle:playable": "npm run bundle",
    "bundle:playable-with-adapters": "npm run bundle",
    "bundle:test": "npm run bundle",
    "bundle:playback-test": "npm run bundle",
    "bundle:playback-test-with-adapters": "npm run bundle",
    "build": "npm run clean && npm run build:types && npm run bundle",
    "test": "npm run test:unit",
    "documentation": "okidoc-md ./docs/docs.yml ./docs",
    "documentation:gitadd": "npm run documentation && git add ./docs",
    "documentation:site": "okidoc-site develop ./docs/site.yml",
    "documentation:site:build": "npm run documentation && okidoc-site build ./docs/site.yml && build-storybook -o ./sitedist/storybook",
    "documentation:site:deploy": "npm run documentation:site:build && gh-pages -d sitedist",
    "version": "node scripts/npm-version.js && conventional-changelog -p angular",
    "release": "node scripts/npm-release.js",
    "tslint": "ts-node node_modules/.bin/tslint -p . -c tslint.json",
    "tslint:all": "npm run tslint -- '{src,scripts}/**/*.ts'",
    "prettier:all": "prettier --write '{src,scripts,tslint-rules,dev-env}/**/*.{js,ts}'",
    "csscomb:all": "csscomb src/.",
    "pretest:node": "npm run clean && npm run bundle",
    "test:node": "node src/e2e/node.js",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "pretest:playback": "npm run clean && npm run bundle",
    "test:playback": "playwright test --config playwright.config.ts",
    "precommit": "lint-staged && npm run documentation:gitadd",
    "storybook": "start-storybook -p 6006",
    "build-storybook": "build-storybook"
  },
  "dependencies": {
    "classnames": "^2.2.6",
    "dashjs": "^3.2.0",
    "eventemitter3": "^4.0.7",
    "hls.js": "1.3.5",
    "resize-observer-polyfill": "^1.5.0",
    "tslib": "^2.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.6.0",
    "@babel/types": "7.0.0-beta.46",
    "@playwright/test": "^1.49.0",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.0.0",
    "@storybook/addon-a11y": "^5.2.1",
    "@storybook/addon-knobs": "^5.2.1",
    "@storybook/addon-viewport": "^5.2.1",
    "@storybook/addons": "^5.2.1",
    "@storybook/html": "^5.2.1",
    "@storybook/theming": "^6.5.8",
    "@types/chance": "^1.0.1",
    "@types/chrome": "^0.0.92",
    "@types/chromecast-caf-sender": "^1.0.3",
    "@types/classnames": "^2.2.7",
    "@types/hls.js": "^0.13.3",
    "@types/node": "^14.14.20",
    "autoprefixer": "^10.4.20",
    "awesome-typescript-loader": "^5.2.1",
    "babel-loader": "^8.0.6",
    "chance": "^1.0.16",
    "conventional-changelog-cli": "^2.0.11",
    "css-loader": "^6.10.0",
    "csscomb": "^4.2.0",
    "dot": "^1.1.3",
    "dotjs-loader": "^0.1.0",
    "gh-pages": "^1.2.0",
    "husky": "^0.14.3",
    "jsdom": "^11.12.0",
    "jsdom-global": "^3.0.2",
    "lint-staged": "^7.3.0",
    "okidoc-md": "^2.0.0",
    "okidoc-site": "^2.0.0",
    "postcss": "^8.4.49",
    "postcss-import": "^16.1.0",
    "postcss-loader": "^8.0.0",
    "prettier": "^1.15.1",
    "rgb-hex": "^3.0.0",
    "rollup": "^4.28.1",
    "rollup-plugin-dot": "^1.0.2",
    "rollup-plugin-postcss": "^4.0.2",
    "sass": "^1.77.0",
    "sass-loader": "^14.0.0",
    "serve": "^14.2.4",
    "style-loader": "^3.3.0",
    "svg-inline-loader": "^0.8.0",
    "ts-loader": "^9.5.0",
    "ts-node": "^10.9.2",
    "tslint": "^5.11.0",
    "tslint-eslint-rules": "^5.4.0",
    "typescript": "^4.1.3",
    "url-loader": "^4.1.1",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "logLevel": "verbose",
    "registry": "https://registry.npmjs.org/"
  },
  "lint-staged": {
    "src/**/*.js": [
      "prettier --write",
      "git add"
    ],
    "src/**/*.ts": [
      "prettier --write",
      "npm run tslint --",
      "git add"
    ],
    "src/**/*.scss": [
      "csscomb -tty-mode --",
      "git add"
    ]
  },
  "packageManager": "yarn@4.12.0+sha512.f45ab632439a67f8bc759bf32ead036a1f413287b9042726b7cc4818b7b49e14e9423ba49b18f9e06ea4941c1ad062385b1d8760a8d5091a1a31e5f6219afca8"
}
